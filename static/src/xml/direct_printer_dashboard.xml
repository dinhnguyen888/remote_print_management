<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="remote_print_management.DirectPrinterDashboard">

        <div class="o_action o_view_controller o_direct_printer_dashboard" style="height: 100%; display: block; overflow-y: auto; background-color: #f8f9fc;">
            <div class="dashboard_container">
                
                <!-- Header Section -->
                <div class="dashboard_header d-flex justify-content-between align-items-center mb-4 mt-2">
                    <div class="header_left">
                        <h1 class="dashboard_title text-dark fw-bold mb-1" style="font-size: 26px; letter-spacing: -0.02em;">Printer Dashboard</h1>
                        <p class="text-muted mb-0" style="font-size: 14px;">Monitor print queues, agent statuses, and recent print activity.</p>
                    </div>
                    <div class="header_right d-flex gap-2">
                        <button class="btn btn-light shadow-sm border d-flex align-items-center" t-on-click="loadData" t-att-disabled="state.loading">
                            <i class="fa fa-refresh me-2 text-muted"/> Refresh
                        </button>
                        <button t-if="this.permissions.allow_quick_print" name="remote_print_management.quick_print_action" type="action" class="btn btn-secondary shadow-sm border d-flex align-items-center" t-on-click="onActionClick">
                            <i class="fa fa-print me-2"/> Quick Print
                        </button>
                        <button t-if="this.permissions.allow_export_report" type="button" class="btn btn-primary shadow-sm d-flex align-items-center" style="background-color: #5b5fc7; border-color: #5b5fc7;" t-on-click="exportReport">
                            <i class="fa fa-file-excel-o me-2"/> Export Report
                        </button>
                    </div>
                </div>

                <!-- Loading Spinner -->
                <div t-if="state.loading" class="d-flex flex-column align-items-center justify-content-center py-5 my-5">
                    <i class="fa fa-spinner fa-spin fa-2x mb-3" style="color: #5b5fc7;"/>
                    <span class="text-muted fw-semibold">Loading dashboard data...</span>
                </div>

                <t t-else="">
                    <!-- KPIs Section -->
                    <div t-if="this.permissions.show_kpis" class="row g-4 mb-4">
                        <!-- Card 1: TOTAL PAGES TODAY -->
                        <div class="col-12 col-sm-6 col-lg-3">
                            <div class="stat_card bg-white rounded-4 p-3 shadow-sm border-0 position-relative h-100 d-flex flex-column">
                                <div class="position-absolute top-0 start-0 w-100" style="height: 4px; background-color: #3b82f6;"></div>
                                
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <span class="text-uppercase fw-bold text-muted" style="font-size: 11px; letter-spacing: 0.05em;">Total Pages Today</span>
                                    <div class="icon-circle d-flex align-items-center justify-content-center rounded-circle" style="width: 32px; height: 32px; background-color: rgba(59, 130, 246, 0.1); color: #3b82f6;">
                                        <i class="fa fa-file-text-o fs-6"/>
                                    </div>
                                </div>
                                
                                <div class="flex-grow-1 d-flex flex-column justify-content-center py-1">
                                    <h2 class="fs-2 fw-bold text-dark mb-0" style="line-height: 1;"><t t-esc="state.data.kpis.total_pages_today || 0"/></h2>
                                    <div class="text-muted mt-1 fw-medium" style="font-size: 12px;">~<t t-esc="state.data.kpis.jobs_today_count || 0"/> Jobs generated</div>
                                </div>
                                
                                <div class="mt-2 pt-2 border-top d-flex align-items-center justify-content-between">
                                    <small t-attf-class="fw-bold {{ state.data.kpis.page_diff_percent &gt;= 0 ? 'text-success' : 'text-danger' }}" style="font-size: 11px;">
                                        <i t-attf-class="fa {{ state.data.kpis.page_diff_percent &gt;= 0 ? 'fa-arrow-up' : 'fa-arrow-down' }} me-1"/>
                                        <t t-esc="state.data.kpis.page_diff_percent &gt;= 0 ? '+' : ''"/><t t-esc="state.data.kpis.page_diff_percent || 0"/>%
                                    </small>
                                    <small class="text-muted" style="font-size: 11px;">vs yesterday</small>
                                </div>
                            </div>
                        </div>

                        <!-- Card 2: AVG. PRINT TIME -->
                        <div class="col-12 col-sm-6 col-lg-3">
                            <div class="stat_card bg-white rounded-4 p-3 shadow-sm border-0 position-relative h-100 d-flex flex-column">
                                <div class="position-absolute top-0 start-0 w-100" style="height: 4px; background-color: #8b5cf6;"></div>
                                
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <span class="text-uppercase fw-bold text-muted" style="font-size: 11px; letter-spacing: 0.05em;">Avg. Print Time</span>
                                    <div class="icon-circle d-flex align-items-center justify-content-center rounded-circle" style="width: 32px; height: 32px; background-color: rgba(139, 92, 246, 0.1); color: #8b5cf6;">
                                        <i class="fa fa-tachometer fs-6"/>
                                    </div>
                                </div>
                                
                                <div class="flex-grow-1 d-flex flex-column justify-content-center py-1">
                                    <div class="d-flex align-items-baseline gap-1">
                                        <h2 class="fs-2 fw-bold text-dark mb-0" style="line-height: 1;"><t t-esc="state.data.kpis.avg_time || 0"/>s</h2>
                                    </div>
                                    <div class="text-muted mt-1 fw-medium" style="font-size: 12px;">per job on average</div>
                                </div>
                                
                                <div class="mt-2 pt-2 border-top d-flex align-items-center justify-content-between">
                                    <small t-attf-class="fw-bold {{ state.data.kpis.avg_time &lt;= 5.0 ? 'text-success' : 'text-warning' }}" style="font-size: 11px;">
                                        <t t-if="state.data.kpis.avg_time &lt;= 5.0"><i class="fa fa-bolt me-1"/> Fast</t>
                                        <t t-else=""><i class="fa fa-warning me-1"/> Slow</t>
                                    </small>
                                    <small class="text-muted" style="font-size: 11px;">Max: <t t-esc="state.data.kpis.max_time || 0"/>s</small>
                                </div>
                            </div>
                        </div>

                        <!-- Card 3: ACTIVE PRINTERS -->
                        <div class="col-12 col-sm-6 col-lg-3">
                            <div class="stat_card bg-white rounded-4 p-3 shadow-sm border-0 position-relative h-100 d-flex flex-column">
                                <div class="position-absolute top-0 start-0 w-100" t-attf-style="height: 4px; background-color: {{ state.data.kpis.online_printers === 0 ? '#ef4444' : '#10b981' }};"></div>
                                
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <span class="text-uppercase fw-bold text-muted" style="font-size: 11px; letter-spacing: 0.05em;">Active Printers</span>
                                    <div t-attf-class="icon-circle d-flex align-items-center justify-content-center rounded-circle {{ state.data.kpis.online_printers === 0 ? 'bg-danger-subtle text-danger' : 'bg-success-subtle text-success' }}" style="width: 32px; height: 32px;">
                                        <i class="fa fa-print fs-6"/>
                                    </div>
                                </div>
                                
                                <div class="flex-grow-1 d-flex flex-column justify-content-center py-1">
                                    <div class="d-flex align-items-baseline gap-2">
                                        <h2 t-attf-class="fs-2 fw-bold mb-0 {{ state.data.kpis.online_printers === 0 ? 'text-danger' : 'text-dark' }}" style="line-height: 1;"><t t-esc="state.data.kpis.online_printers || 0"/></h2>
                                        <span class="text-muted fs-6 fw-medium">/ <t t-esc="state.data.kpis.total_printers || 0"/></span>
                                    </div>
                                    <div class="text-muted mt-1 fw-medium" style="font-size: 12px;">from <t t-esc="state.data.kpis.active_clients || 0"/> connected agents</div>
                                </div>
                                
                                <div class="mt-2 pt-2 border-top d-flex align-items-center justify-content-between">
                                    <small t-if="state.data.kpis.online_printers === 0" class="text-danger fw-bold" style="font-size: 11px;"><i class="fa fa-exclamation-circle me-1"/> All offline</small>
                                    <small t-elif="state.data.kpis.online_printers &lt; state.data.kpis.total_printers" class="text-warning-emphasis fw-bold" style="font-size: 11px;"><i class="fa fa-exclamation-triangle me-1"/> Some offline</small>
                                    <small t-else="" class="text-success fw-bold" style="font-size: 11px;"><i class="fa fa-check-circle me-1"/> All online</small>
                                </div>
                            </div>
                        </div>

                        <!-- Card 4: JOB STATUS -->
                        <div class="col-12 col-sm-6 col-lg-3">
                            <div class="stat_card bg-white rounded-4 p-3 shadow-sm border-0 position-relative h-100 d-flex flex-column cursor-pointer" t-on-click="() => this.openLaneJobs('failed')">
                                <div class="position-absolute top-0 start-0 w-100" t-attf-style="height: 4px; background-color: {{ state.data.kpis.failed &gt; 0 ? '#ef4444' : '#10b981' }};"></div>
                                
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <span class="text-uppercase fw-bold text-muted" style="font-size: 11px; letter-spacing: 0.05em;">Job Status</span>
                                    <div t-attf-class="icon-circle d-flex align-items-center justify-content-center rounded-circle {{ state.data.kpis.failed &gt; 0 ? 'bg-danger-subtle text-danger' : 'bg-success-subtle text-success' }}" style="width: 32px; height: 32px;">
                                        <i t-attf-class="fa {{ state.data.kpis.failed &gt; 0 ? 'fa-exclamation-triangle fs-6 flash-icon' : 'fa-check fs-6' }}"/>
                                    </div>
                                </div>
                                
                                <div class="flex-grow-1 d-flex flex-column justify-content-center py-1">
                                    <t t-if="state.data.kpis.failed &gt; 0">
                                        <div class="d-flex align-items-baseline gap-2">
                                            <h2 class="fs-2 fw-bold text-danger mb-0" style="line-height: 1;"><t t-esc="state.data.kpis.failed"/></h2>
                                            <span class="fw-bold text-danger" style="font-size: 12px;">FAILED</span>
                                        </div>
                                        <div class="text-muted mt-1 fw-medium" style="font-size: 12px;"><t t-esc="state.data.kpis.done_today"/> jobs successful</div>
                                    </t>
                                    <t t-else="">
                                        <div class="d-flex align-items-baseline gap-2">
                                            <h2 class="fs-2 fw-bold text-dark mb-0" style="line-height: 1;"><t t-esc="state.data.kpis.done_today"/></h2>
                                            <span class="fw-bold text-success" style="font-size: 12px;">DONE</span>
                                        </div>
                                        <div class="text-muted mt-1 fw-medium" style="font-size: 12px;">0 jobs failed</div>
                                    </t>
                                </div>
                                
                                <div class="mt-2 pt-2 border-top d-flex align-items-center justify-content-between">
                                    <small t-if="state.data.kpis.failed &gt; 0" class="text-danger fw-bold" style="font-size: 11px;"><i class="fa fa-filter me-1"/> Filter failed</small>
                                    <small t-else="" class="text-success fw-bold" style="font-size: 11px;"><i class="fa fa-shield me-1"/> 100% Success</small>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Content Grid Section -->
                    <div class="row g-4 mb-4">
                        <!-- Left Column: Volume Chart & Lanes -->
                        <div class="col-12 col-lg-8 d-flex flex-column gap-4">
                            <!-- Hourly Volume Chart -->
                            <div t-if="this.permissions.show_chart" class="bg-white shadow-sm border-0 rounded-4 p-4">
                                <div class="d-flex align-items-center justify-content-between mb-4">
                                    <h5 class="fw-bold text-dark mb-0">Hourly Print Volume</h5>
                                    <div class="text-muted small fw-medium px-3 py-1 bg-light rounded-pill">Done / Printing / Failed</div>
                                </div>
                                <div style="min-height: 280px;" t-ref="rpdChart"></div>
                            </div>

                            <!-- Lanes Area (Pending, Printing, Failed jobs lists) -->
                            <div t-if="this.permissions.show_lanes" class="row g-4">
                                <t t-foreach="[['pending', 'Pending', 'bg-warning'], ['printing', 'Printing', 'bg-info'], ['failed', 'Failed', 'bg-danger']]" t-as="lane" t-key="lane[0]">
                                    <div class="col-12 col-md-4">
                                        <div class="p-3 rounded-4 bg-white shadow-sm border-0 h-100 d-flex flex-column">
                                            <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom">
                                                <div class="d-flex align-items-center gap-2">
                                                    <div t-attf-class="status-indicator {{ lane[2] }}"/>
                                                    <span class="fw-bold text-dark" t-esc="lane[1]"/>
                                                </div>
                                                <span class="badge bg-light text-dark border rounded-pill px-2" t-esc="this.laneJobs(lane[0]).length"/>
                                            </div>
                                            <div class="flex-grow-1 overflow-auto custom-scroll" style="height: 340px;">
                                                <t t-foreach="this.laneJobs(lane[0])" t-as="job" t-key="job.id">
                                                    <div class="lane-job-card border p-3 mb-2 rounded-3 cursor-pointer shadow-sm" t-on-click="() => this.openJob(job)">
                                                        <div class="fw-bold text-dark text-truncate mb-1" style="font-size: 13px;" t-esc="job.name"/>
                                                        <div class="text-muted text-truncate d-flex align-items-center gap-1" style="font-size: 12px;">
                                                            <i class="fa fa-print opacity-75"/> <t t-esc="job.printer"/>
                                                        </div>
                                                        <div class="text-muted mt-2 fw-medium" style="font-size: 11px;">
                                                            <t t-esc="job.copies"/> copies
                                                        </div>
                                                    </div>
                                                </t>
                                                <div t-if="!this.laneJobs(lane[0]).length" class="text-center text-muted py-4 small d-flex flex-column align-items-center gap-2">
                                                    <i class="fa fa-inbox fs-3 opacity-25"/>
                                                    <span>No jobs</span>
                                                </div>
                                            </div>
                                            <div class="mt-2 pt-2 border-top text-center">
                                                <button class="btn btn-sm btn-light border rounded-pill w-100 text-primary fw-medium" style="font-size: 12px;" t-on-click="() => this.openLaneJobs(lane[0])">
                                                    <i class="fa fa-arrow-right me-1"/> Show More
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </t>
                            </div>
                        </div>

                        <!-- Right Column: Agents & Printers -->
                        <div t-if="this.permissions.show_agents" class="col-12 col-lg-4">
                            <div class="bg-white shadow-sm border-0 rounded-4 p-4 h-100 d-flex flex-column">
                                <div class="d-flex align-items-center justify-content-between mb-4">
                                    <h5 class="fw-bold text-dark mb-0">Agents &amp; Printers</h5>
                                    <span class="badge bg-light text-dark border rounded-pill px-3 py-1" t-esc="state.data.agents.length + ' printers'"/>
                                </div>
                                <div class="flex-grow-1 overflow-auto custom-scroll" style="height: 400px; padding-right: 5px;">
                                    <div class="d-flex flex-column gap-3">
                                        <div class="agent-card p-3 border rounded-4 d-flex align-items-center justify-content-between bg-white" t-foreach="this.visibleAgents" t-as="agent" t-key="agent.id || agent_index">
                                            <div class="d-flex align-items-center gap-3">
                                                <div class="position-relative">
                                                    <div class="icon-circle bg-light d-flex align-items-center justify-content-center rounded-circle border" style="width: 42px; height: 42px;">
                                                        <i class="fa fa-server text-secondary"/>
                                                    </div>
                                                    <div t-attf-class="status-indicator position-absolute bottom-0 end-0 {{ agent.status == 'online' ? 'bg-success' : (agent.status == 'warning' ? 'bg-warning' : 'bg-danger') }}"/>
                                                </div>
                                                <div>
                                                    <div class="fw-bold text-dark mb-1" style="font-size: 14px;" t-esc="agent.name"/>
                                                    <div class="text-muted" style="font-size: 12px;" t-esc="agent.detail"/>
                                                </div>
                                            </div>
                                            <div class="d-flex align-items-center gap-2">
                                                <span t-attf-class="badge {{ agent.status == 'online' ? 'bg-success-subtle text-success' : (agent.status == 'warning' ? 'bg-warning-subtle text-warning-emphasis' : 'bg-danger-subtle text-danger') }} px-2 py-1 rounded-pill fw-medium" t-esc="agent.label"/>
                                            </div>
                                        </div>
                                        <div t-if="!state.data.agents.length" class="text-center text-muted py-5">
                                            <i class="fa fa-print fa-3x mb-3 text-secondary opacity-25"/>
                                            <p class="mb-0">No printers configured.</p>
                                        </div>
                                    </div>
                                </div>
                                <div class="mt-3 pt-2 border-top text-center">
                                    <button class="btn btn-light border rounded-pill w-100 text-primary fw-semibold" t-on-click="showMorePrinters">
                                        <i class="fa fa-arrow-right me-1"/> Show More Printers
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Recent Jobs Section (Max 10 displayed) -->
                    <div t-if="this.permissions.show_recent_jobs" class="bg-white shadow-sm border-0 rounded-4 mb-4 overflow-hidden">
                        <div class="bg-white border-bottom py-4 px-4 d-flex align-items-center justify-content-between">
                            <h5 class="fw-bold text-dark mb-0">Recent Jobs</h5>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0 custom-table">
                                <thead class="table-light text-muted">
                                    <tr>
                                        <th class="px-4 py-3 fw-bold border-0">Time</th>
                                        <th class="py-3 fw-bold border-0">Report</th>
                                        <th class="py-3 fw-bold border-0">Printer</th>
                                        <th class="py-3 fw-bold border-0">Node</th>
                                        <th class="py-3 fw-bold border-0">Sender</th>
                                        <th class="py-3 fw-bold text-end border-0">Copies</th>
                                        <th class="px-4 py-3 fw-bold border-0">State</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="this.visibleJobs" t-as="job" t-key="job.id" t-on-click="() => this.openJob(job)" class="cursor-pointer">
                                        <td class="px-4 py-3 text-dark small" t-esc="job.time"/>
                                        <td class="py-3 fw-bold text-dark small" t-esc="job.name"/>
                                        <td class="py-3 text-muted small" t-esc="job.printer"/>
                                        <td class="py-3 text-muted small" t-esc="job.client"/>
                                        <td class="py-3 text-muted small" t-esc="job.sender"/>
                                        <td class="py-3 text-dark text-end fw-medium small" t-esc="job.copies"/>
                                        <td class="px-4 py-3">
                                            <span t-attf-class="badge {{ (job.state == 'printed' || job.state == 'done') ? 'bg-success-subtle text-success' : (job.state == 'failed' ? 'bg-danger-subtle text-danger' : 'bg-warning-subtle text-warning-emphasis') }} px-2 py-1 rounded-pill fw-medium" t-esc="this.stateLabel(job.state)"/>
                                        </td>
                                    </tr>
                                    <tr t-if="!state.data.jobs.length">
                                        <td colspan="7" class="text-center text-muted py-5">
                                            <p class="mb-0">No matching jobs found.</p>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <div class="p-3 text-center border-top">
                            <button class="btn btn-light border rounded-pill text-primary fw-semibold px-4" t-on-click="showMoreJobs">
                                <i class="fa fa-arrow-right me-1"/> Show More Jobs
                            </button>
                        </div>
                    </div>
                </t>
            </div>
        </div>
    </t>
</templates>
