<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Printer Details List View -->
    <record id="printer_details_view_tree" model="ir.ui.view">
        <field name="name">printer.details.view.list</field>
        <field name="model">printer.details</field>
        <field name="arch" type="xml">
            <list create="0">
                <field name="printers_name"/>
                <field name="id_of_printer"/>
                <field name="client_id"/>
                <field name="windows_printer_name"/>
                <field name="hardware_status"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'online'"
                       decoration-danger="state in ('offline', 'error')"
                       decoration-warning="state in ('paper_out', 'paper_jam', 'door_open')"/>
            </list>
        </field>
    </record>

    <!-- Printer Details Form View -->
    <record id="printer_details_view_form" model="ir.ui.view">
        <field name="name">printer.details.view.form</field>
        <field name="model">printer.details</field>
        <field name="arch" type="xml">
            <form create="0">
                <header>
                    <button name="action_revoke" type="object" string="Delete Printer" class="btn-danger" confirm="Are you sure you want to delete this printer?"/>
                </header>
                <sheet>
                    <group>
                        <group string="Printer Information">
                            <field name="printers_name"/>
                            <field name="id_of_printer"/>
                            <field name="client_id"/>
                            <field name="windows_printer_name"/>
                        </group>
                        <group string="Status &amp; Hardware">
                            <field name="hardware_status" readonly="1"/>
                            <field name="state" readonly="1"/>
                            <field name="printer_description"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="tray_options" readonly="1"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Printer Details Search View -->
    <record id="printer_details_view_search" model="ir.ui.view">
        <field name="name">printer.details.view.search</field>
        <field name="model">printer.details</field>
        <field name="arch" type="xml">
            <search string="Search Printers">
                <field name="printers_name"/>
                <field name="id_of_printer"/>
                <field name="client_id"/>
                <field name="windows_printer_name"/>
                <filter string="Online" name="filter_online" domain="[('state', '=', 'online')]"/>
                <filter string="Offline" name="filter_offline" domain="[('state', '=', 'offline')]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="groupby_state" context="{'group_by': 'state'}"/>
                    <filter string="Node" name="groupby_client_id" context="{'group_by': 'client_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Printer Details Window Action -->
    <record id="printer_details_action" model="ir.actions.act_window">
        <field name="name">Printers</field>
        <field name="res_model">printer.details</field>
        <field name="path">printers</field>
        <field name="search_view_id" ref="printer_details_view_search"/>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Quick Print Wizard Form View -->
    <record id="quick_print_wizard_view_form" model="ir.ui.view">
        <field name="name">quick.print.wizard.form</field>
        <field name="model">quick.print.wizard</field>
        <field name="arch" type="xml">
            <form string="Quick Print">
                <sheet>
                    <group>
                        <field name="printer_id" options="{'no_create': True}"/>
                    </group>
                    <div class="mt-4">
                        <label for="document" class="form-label fw-bold mb-2">Document to Print</label>
                        <field name="document" filename="file_name" widget="dropzone_binary" class="w-100 d-block"/>
                        <field name="attachment_id" invisible="1"/>
                        <field name="file_name" invisible="1"/>
                    </div>
                </sheet>
                <footer>
                    <button string="Print Immediately" type="object" name="action_print" class="btn btn-primary px-4"/>
                    <button string="Cancel" class="btn btn-secondary px-3" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Quick Print Window Action -->
    <record id="quick_print_action" model="ir.actions.act_window">
        <field name="name">Quick Print</field>
        <field name="res_model">quick.print.wizard</field>
        <field name="path">quick_print</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
